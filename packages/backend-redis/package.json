{
  "name": "@dianemo/backend-redis",
  "version": "1.0.0",
  "description": "Redis backend for dianemo \u2014 one shared API budget across every process, for any deployment larger than one",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dianemo",
    "rate-limit",
    "redis",
    "valkey",
    "distributed",
    "token-bucket"
  ],
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@dianemo/core": "^1.0.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@dianemo/core": "^1.0.0",
    "@types/node": "^25.9.2",
    "ioredis": "^5.11.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivo-us/dianemo.git",
    "directory": "packages/backend-redis"
  },
  "homepage": "https://github.com/vivo-us/dianemo#readme",
  "bugs": {
    "url": "https://github.com/vivo-us/dianemo/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
